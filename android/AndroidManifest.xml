<?xml version="1.0" encoding="utf-8"?>
<!-- Dex Art Tracker for Android: opens <your server>/view/ and uses the server for everything. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="nl.thepuppet.dexart">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- for scanning cards with the camera inside the app -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- usesCleartextTraffic: lets the app reach a server on your home network over plain http
         (the camera itself only works over https) -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/DexTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
